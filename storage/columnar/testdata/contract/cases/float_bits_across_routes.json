        ]
      }
    },
    {
      "op": "append",
      "args": {
        "series": {
          "__name__": "contract_bits",
          "kind": "histogram"
        },
        "samples": [
          {
            "t": 1000,
            "histogram": {
              "type": "integer",
              "count": "4",
              "sum_bits": "0x4025000000000000",
              "schema": 0,
              "zero_threshold_bits": "0x0000000000000000",
              "zero_count": "0",
              "positive_spans": [
                {
                  "offset": 1,
                  "length": 2
                }
