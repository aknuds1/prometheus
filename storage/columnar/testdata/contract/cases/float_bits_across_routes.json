{
  "id": "float_bits_across_routes",
  "title": "Exact float bits, native histograms and staleness survive append, query, flush and reopen identically on the columnar and stock TSDB routes",
  "obligations": [
    "fixed-case-13",
    "fixed-case-8",
    "invariant-2",
    "route-equivalence"
  ],
  "routes": [
    "columnar",
    "tsdb"
  ],
  "scope": "Settled sample semantics only. The fixture states no metadata, so it does not touch any open identity, association or provenance decision. Start timestamps are asserted by start_timestamps_across_routes.json on the columnar route and on explicitly ST-enabled stock TSDB; stock TSDB with default options does not retain a per-sample start timestamp, and that configuration fact is recorded separately.",
  "events": [
    {
      "op": "append",
      "args": {
        "series": {
          "__name__": "contract_bits",
          "kind": "special"
        },
        "samples": [
          {
            "t": 1000,
            "value": "1.5"
          },
          {
            "t": 2000,
            "bits": "0x8000000000000000"
          },
          {
            "t": 3000,
            "bits": "0x7ff8000000000001"
          },
          {
            "t": 4000,
            "bits": "0x7ff0000000000000"
          },
          {
            "t": 5000,
            "bits": "0x0000000000000001"
          },
          {
            "t": 6000,
            "stale": true
          }
        ]
      }
    },
    {
      "op": "append",
      "args": {
        "series": {
          "__name__": "contract_bits",
          "kind": "plain"
        },
        "samples": [
          {
            "t": 1000,
            "value": "2.25"
