{
  "id": "start_timestamps_across_routes",
  "title": "Per-sample start timestamps are exact before and after both applicable persistence operations: flush plus reopen on the columnar route and head compaction on an explicitly ST-enabled stock TSDB",
  "obligations": [
    "fixed-case-13",
    "fixed-case-8",
    "route-difference-stock-start-timestamps"
  ],
  "routes": [
    "columnar",
    "tsdb_st"
  ],
  "open_decisions": [],
  "scope": "Both routes preserve a per-sample start timestamp for float and integer-histogram samples. The fixture asserts the complete sample payload and ST before any persistence and again after the applicable operation: flush plus reopen for the columnar route, head compaction for the stock route. The stock comparator is explicitly configured with EnableSTStorage, EncXOR2 float chunks and EnableHistogramSTEncoding; the default tsdb route is not ST-capable, and that default-configuration fact is what route-difference-stock-start-timestamps records. ST-enabled columnar is never compared with ST-disabled stock TSDB. No exemplar is claimed here: exemplar persistence is gap-exemplars.",
  "events": [
    {
      "op": "append",
      "args": {
        "series": {
          "__name__": "contract_st",
          "kind": "float"
        },
        "samples": [
          {
            "t": 2000,
            "start": 1500,
            "value": "1"
          },
          {
            "t": 3000,
            "start": 1500,
            "value": "2"
          }
        ]
      }
    },
    {
      "op": "append",
      "args": {
        "series": {
          "__name__": "contract_st",
          "kind": "histogram"
        },
        "samples": [
          {
            "t": 2000,
            "start": 1500,
            "histogram": {
              "type": "integer",
              "count": "1",
              "sum_bits": "0x3ff0000000000000",
              "schema": 0,
              "zero_threshold_bits": "0x0000000000000000",
              "zero_count": "0",
              "positive_spans": [
                {
                  "offset": 0,
                  "length": 1
                }
              ],
              "positive_buckets": [
                "1"
              ],
              "counter_reset_hint": 0
            }
          }
        ]
      }
    },
    {
      "op": "state",
      "expect": {
        "series": [
          {
            "labels": "{__name__=\"contract_st\", kind=\"float\"}",
            "samples": [
              "2000|0x3ff0000000000000|float|1500",
              "3000|0x4000000000000000|float|1500"
            ]
          },
          {
            "labels": "{__name__=\"contract_st\", kind=\"histogram\"}",
            "samples": [
              "2000|h:count=1;sum=0x3ff0000000000000;schema=0;zero_threshold=0x0000000000000000;zero_count=0;pos=[0/1]1;neg=[];hint=0|histogram|1500"
            ]
          }
        ]
      }
    },
    {
      "op": "flush",
      "routes": [
        "columnar"
      ]
    },
    {
      "op": "reopen",
      "routes": [
        "columnar"
      ]
    },
    {
      "op": "compact",
      "routes": [
        "tsdb_st"
      ],
      "args": {
        "mint": 2000,
        "maxt": 3000
      }
    },
    {
      "op": "promql",
      "args": {
        "expr": "contract_st",
        "at": 3000
      },
      "expect": {
        "series": [
          {
            "labels": "{__name__=\"contract_st\", kind=\"float\"}",
            "samples": [
              "0x4000000000000000"
            ]
          },
          {
            "labels": "{__name__=\"contract_st\", kind=\"histogram\"}",
            "samples": [
              "fh:count=0x3ff0000000000000;sum=0x3ff0000000000000;schema=0;zero_threshold=0x0000000000000000;zero_count=0x0000000000000000;pos=[0/1]0x3ff0000000000000;neg=[];hint=0"
            ]
          }
        ]
      }
    }
  ],
  "state": {
    "series": [
      {
        "labels": "{__name__=\"contract_st\", kind=\"float\"}",
        "samples": [
          "2000|0x3ff0000000000000|float|1500",
          "3000|0x4000000000000000|float|1500"
        ]
      },
      {
        "labels": "{__name__=\"contract_st\", kind=\"histogram\"}",
        "samples": [
          "2000|h:count=1;sum=0x3ff0000000000000;schema=0;zero_threshold=0x0000000000000000;zero_count=0;pos=[0/1]1;neg=[];hint=0|histogram|1500"
        ]
      }
    ]
  }
}
