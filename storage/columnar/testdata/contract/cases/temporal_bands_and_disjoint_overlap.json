{
  "id": "temporal_bands_and_disjoint_overlap",
  "title": "A/B/A validity bands, unchanged observations that only extend bounds, unassociated series survival, and the joint version/membership/range overlap requirement",
  "obligations": [
    "fixed-case-10",
    "fixed-case-4",
    "fixed-case-5",
    "fixed-case-9",
